#!/usr/bin/env bash
# A commit here may have changed a module, which leaves every registered repo
# stale — and their own pre-commit hooks would be the ones to complain. Re-render
# the fleet now, so the change is waiting in each repo as an ordinary edit.
#
# git ignores this hook's exit status, and so do we: a missing toolchain or a
# repo that refuses its sync must never look like a failed commit.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v go > /dev/null 2>&1; then
  echo "post-commit: go is not installed; run 'make sync' by hand to re-render the registered repos."
  exit 0
fi

echo "==> make sync (re-rendering every registered repo)"
if ! make sync; then
  echo ""
  echo "post-commit: 'make sync' did not finish. The commit stands; re-run it by hand:"
  echo "  make sync        # or 'agents diff' first, if a repo has hand-edited regions"
fi
exit 0
