#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "==> go vet"
go vet ./...

echo "==> go fix"
# `go fix` can rewrite files in place without printing anything, so compare
# the worktree against the staged set: any change to a staged file is a hard
# fail with a re-stage hint, instead of a silent follow-up commit.
go fix ./... > /dev/null
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged" ]; then
  modified=$(git diff --name-only -- $staged)
  if [ -n "$modified" ]; then
    echo "go fix modified staged files:"
    echo "$modified"
    echo ""
    echo "Re-stage and commit again:"
    echo "  git add $(echo $modified | tr '\n' ' ') && git commit ..."
    exit 1
  fi
fi

echo "==> gofmt"
# Skip .claude/worktrees: a running agent's half-typed file must not fail an
# unrelated commit on the main thread.
unformatted=$(find . -name "*.go" -not -path "./.claude/*" -exec gofmt -l {} +)
if [ -n "$unformatted" ]; then
  echo "gofmt needs to format these files:"
  echo "$unformatted"
  echo ""
  echo "Run: gofmt -w ."
  exit 1
fi

echo "==> go mod tidy"
go mod tidy
if ! git diff --quiet go.mod go.sum 2>/dev/null; then
  echo "go.mod or go.sum changed after go mod tidy"
  echo "Run: go mod tidy && git add go.mod go.sum"
  exit 1
fi

echo "==> go test"
go test ./...

echo "==> go build"
go build ./...

# This repo dogfoods the tool: AGENTS.md here must be exactly what the
# modules render, so a module edit that wasn't re-rendered can't land. `check`
# fails on exactly what `sync` would write, and unlike `sync` it never touches
# the tree mid-commit.
echo "==> agents check"
go run ./cmd/agents check

echo ""
echo "All checks passed."
